# ==============================================================================
# VEYA — UNIVERSAL AI SKILL ENGINE ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI PROVIDER SELECTION
# ------------------------------------------------------------------------------
# Provider Options:
#   - 'openrouter' : OpenRouter API (Access to Claude, GPT, Llama, Nemotron, etc.)
#   - 'gemini'     : Google Gemini API (Direct via @google/genai SDK)
#   - 'ollama'     : Local Ollama Instance (Runs models locally on localhost)
EXPO_PUBLIC_AI_PROVIDER=openrouter

# ------------------------------------------------------------------------------
# 2. AI MODEL SELECTION
# ------------------------------------------------------------------------------
# Model can be ANY string identifier supported by the active provider:
#
# OpenRouter Examples:
#   - 'nvidia/nemotron-3.5-lightning:free'
#   - 'anthropic/claude-3.5-sonnet'
#   - 'openai/gpt-4o'
#   - 'google/gemini-2.5-flash'
#   - 'meta-llama/llama-3.1-70b-instruct'
#   - 'deepseek/deepseek-r1'
#
# Gemini Direct Examples (@google/genai SDK):
#   - 'gemini-2.5-flash'
#   - 'gemini-1.5-pro'
#   - 'gemini-1.5-flash-lite'
#
# Ollama Examples (Local):
#   - 'llama3'
#   - 'mistral'
#   - 'codellama'
#   - 'qwen2.5-coder'
EXPO_PUBLIC_AI_MODEL=nvidia/nemotron-3.5-lightning:free

# ------------------------------------------------------------------------------
# 3. API KEYS & ENDPOINTS
# ------------------------------------------------------------------------------

# OpenRouter API Key (Get at: https://openrouter.ai/keys)
EXPO_PUBLIC_OPENROUTER_API_KEY=

# Google Gemini API Key (Get at: https://aistudio.google.com/)
EXPO_PUBLIC_GEMINI_API_KEY=

# Ollama Server URL (Default local endpoint)
EXPO_PUBLIC_OLLAMA_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
# - Leave default placeholders for local in-memory fallback database mode.
# - Provide real project URL and anon key to connect to live Supabase PostgreSQL.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
